{
  "name": "dsh-qq-whale",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "大肥鱼：DSH 的 QQ 伙伴，支持记忆、情绪、本地媒体理解、浏览器、创作和分段唱歌语音。",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/",
    "client/",
    "README.md",
    "SKILL.md",
    "assets/",
    "runtime/",
    "tools/",
    "requirements-speech.txt",
    "CREATIVE_TOOLS.md",
    "SOCIAL_BEHAVIOR.md",
    "TOOLS.md",
    "INSTALL.cmd",
    "install.ps1",
    "LICENSE",
    "GETTING_STARTED.md",
    "VOICE_SETUP.md",
    "RELEASE_0.23.0.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "assistant",
    "tutor",
    "automation",
    "browser",
    "jev",
    "gutsy",
    "deeptutor"
  ],
  "license": "MIT",
  "dependencies": {
    "@puppeteer/browsers": "^2.3.0",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^22.15.0",
    "xhshow-js": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "undici": "^6.21.3"
  },
  "scripts": {
    "verify:upgrade": "node tools/verify-upgrade.mjs",
    "verify:integration": "node tools/verify-upgrade.mjs --integration",
    "verify:qq": "node tools/verify-qq.mjs",
    "verify:memory": "node tools/verify-memory-search.mjs",
    "verify:optimization": "node tools/verify-optimization.mjs",
    "verify:scroll": "node tools/verify-chat-scroll.mjs",
    "verify:media": "node tools/verify-media-speed.mjs",
    "verify:voice": "node tools/verify-voice-clock.mjs",
    "verify:persona": "node tools/verify-persona-ui.mjs",
    "verify:conversation": "node tools/verify-conversation.mjs",
    "verify:personality": "node tools/verify-personality.mjs",
    "verify:creative": "node tools/verify-creative.mjs",
    "verify:social": "node tools/verify-social-personality.mjs",
    "verify:social-ui": "node tools/verify-social-ui.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "verify:voice-worker": "node tools/verify-cosy.mjs",
    "verify:privacy": "node tools/verify-public-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yeduwuren20000-del/dsh-qq-whale.git"
  }
}
