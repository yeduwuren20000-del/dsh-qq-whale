{
  "name": "dsh-mentor",
  "version": "0.21.2",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "大肥鱼 (dsh-mentor)：住在 DSH 里的蓝白鲸鱼，爱吃白饭（token）、聪明但懒、傲娇嘴硬。想到什么说什么，她自己判断该陪着聊还是把事办掉；干活能接管浏览器（抖音/小红书/B站发布、填表上传）与本机窗口。",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/",
    "client/",
    "README.md",
    "SKILL.md",
    "assets/",
    "runtime/",
    "tools/",
    "RELEASE_0.20.0.md",
    "RELEASE_0.20.1.md",
    "RELEASE_0.21.1.md",
    "RELEASE_0.21.2.md",
    "requirements-speech.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "assistant",
    "tutor",
    "automation",
    "browser",
    "jev",
    "gutsy",
    "deeptutor"
  ],
  "license": "MIT",
  "dependencies": {
    "@puppeteer/browsers": "^2.3.0",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^22.15.0",
    "xhshow-js": "^1.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "undici": "^6.21.3"
  },
  "scripts": {
    "verify:upgrade": "node tools/verify-upgrade.mjs",
    "verify:integration": "node tools/verify-upgrade.mjs --integration",
    "verify:qq": "node tools/verify-qq.mjs",
    "verify:memory": "node tools/verify-memory-search.mjs"
  }
}
